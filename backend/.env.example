NODE_ENV=development
PORT=3000
# Reverse-proxy hops to trust for client IPs (0 when the API is exposed directly)
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://lms_app:change-me@localhost:5432/lms

# Enrollment webhook (external payment platform)
ENROLLMENT_WEBHOOK_PROVIDER=payment_engine
# keyId:secret pairs, comma-separated. Secrets >= 32 chars, e.g. `openssl rand -base64 48`
ENROLLMENT_WEBHOOK_KEYS=key_2026a:replace-with-a-long-random-secret-of-at-least-32-chars
ENROLLMENT_WEBHOOK_TOLERANCE_SECONDS=300
