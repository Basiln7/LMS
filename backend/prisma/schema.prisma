// =============================================================================
//  LMS — Secure recorded-class delivery
//  PostgreSQL 15+ · Prisma 7
//
//  Conventions
//  - Primary keys are time-ordered UUIDv7 (index-friendly, non-enumerable).
//  - All timestamps are timestamptz with millisecond precision.
//  - Tables / columns are snake_case in SQL, camelCase in TypeScript.
//  - Emails are stored normalised (trimmed + lower-cased) by the application.
//  - Nothing here stores card/payment data: commerce lives on the external
//    payment platform, which only talks to us through signed webhooks.
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
//  Enums
// -----------------------------------------------------------------------------

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  PENDING_ACTIVATION // provisioned by webhook, has not set a password yet
  ACTIVE
  SUSPENDED // account-level block (abuse, piracy) — independent of enrollments
  DISABLED
}

enum AuthTokenType {
  ACCOUNT_ACTIVATION
  PASSWORD_RESET
}

enum SessionRevokeReason {
  LOGOUT
  DEVICE_LIMIT // evicted because a newer device signed in (max 2)
  ADMIN_ACTION
  PASSWORD_CHANGED
  REFRESH_TOKEN_REUSE // stolen refresh token detected → whole family revoked
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
}

enum VideoProvider {
  VDOCIPHER
  BUNNY_STREAM
}

enum VideoAssetStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  FAILED
}

enum EnrollmentStatus {
  ACTIVE
  SUSPENDED // reversible (dispute, manual hold)
  REVOKED // refund / chargeback lost — only a newer GRANT re-opens it
  EXPIRED // expires_at reached (set by sweeper job or on read)
}

enum EnrollmentSource {
  WEBHOOK
  ADMIN
  SYSTEM
}

enum AccessChangeReason {
  PURCHASE
  RENEWAL
  REFUND
  CHARGEBACK
  MANUAL
  EXPIRY
  OTHER
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum CommentStatus {
  VISIBLE
  HIDDEN // hidden by a moderator
  DELETED // soft-deleted by author; kept so replies keep their parent
}

enum AuditActorType {
  USER
  WEBHOOK
  SYSTEM
}

// -----------------------------------------------------------------------------
//  Identity & sessions
// -----------------------------------------------------------------------------

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  email           String     @unique @db.VarChar(254)
  fullName        String?    @map("full_name") @db.VarChar(200)
  phone           String?    @db.VarChar(32)
  /// argon2id hash. NULL until the student completes activation.
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  role            UserRole   @default(STUDENT)
  status          UserStatus @default(PENDING_ACTIVATION)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  /// Bump to invalidate every JWT issued to this user at once.
  tokenVersion    Int        @default(0) @map("token_version")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  externalIdentities ExternalIdentity[]
  authTokens         AuthToken[]
  sessions           UserSession[]
  enrollments        Enrollment[]
  lessonProgress     LessonProgress[]
  moduleProgress     ModuleProgress[]
  playbackSessions   PlaybackSession[]
  quizAttempts       QuizAttempt[]
  comments           LessonComment[]

  @@index([status])
  @@map("users")
}

/// Links an LMS user to a customer record on an external system (the payment engine).
model ExternalIdentity {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String   @db.VarChar(64)
  externalId String   @map("external_id") @db.VarChar(191)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@unique([userId, provider])
  @@map("external_identities")
}

/// One-time tokens (activation, password reset). Only the SHA-256 hash is stored.
model AuthToken {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?     @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

/// A signed-in device. `id` is the `sid` claim inside access tokens, so revoking a
/// row kills that device immediately. The device limit (2) is enforced against
/// rows where revoked_at IS NULL AND expires_at > now().
model UserSession {
  id               String               @id @default(uuid(7)) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  /// SHA-256 of the current refresh token (rotated on every refresh).
  refreshTokenHash String               @unique @map("refresh_token_hash") @db.Char(64)
  /// Rotation lineage: re-use of an already-rotated token revokes the family.
  tokenFamilyId    String               @map("token_family_id") @db.Uuid
  deviceLabel      String?              @map("device_label") @db.VarChar(128)
  userAgent        String?              @map("user_agent") @db.VarChar(512)
  ipAddress        String?              @map("ip_address") @db.Inet
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt       DateTime             @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokeReason     SessionRevokeReason? @map("revoke_reason")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  playbackSessions PlaybackSession[]

  @@index([userId, revokedAt, lastSeenAt])
  @@index([tokenFamilyId])
  @@map("user_sessions")
}

// -----------------------------------------------------------------------------
//  Catalog (read-only mirror of what is sold elsewhere)
// -----------------------------------------------------------------------------

model Course {
  id          String       @id @default(uuid(7)) @db.Uuid
  slug        String       @unique @db.VarChar(160)
  title       String       @db.VarChar(255)
  description String?
  status      CourseStatus @default(DRAFT)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  externalRefs CourseExternalRef[]
  modules      CourseModule[]
  enrollments  Enrollment[]

  @@map("courses")
}

/// Maps identifiers used by the external payment platform (product/SKU ids) to an
/// LMS course. Webhooks never reference internal UUIDs, and several SKUs (e.g.
/// regional prices) may point at the same course.
model CourseExternalRef {
  id         String   @id @default(uuid(7)) @db.Uuid
  courseId   String   @map("course_id") @db.Uuid
  provider   String   @db.VarChar(64)
  externalId String   @map("external_id") @db.VarChar(191)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([provider, externalId])
  @@index([courseId])
  @@map("course_external_refs")
}

model CourseModule {
  id              String   @id @default(uuid(7)) @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  /// 1-based order inside the course. Module N is gated by module N-1.
  position        Int
  title           String   @db.VarChar(255)
  /// Time-based drip: the module also unlocks this many days after the
  /// enrollment's access_starts_at, even if module N-1 is incomplete.
  /// NULL = unlocks on completion of the previous module only.
  unlockAfterDays Int?     @map("unlock_after_days")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
  progress ModuleProgress[]

  @@unique([courseId, position])
  @@map("course_modules")
}

model Lesson {
  id                  String     @id @default(uuid(7)) @db.Uuid
  moduleId            String     @map("module_id") @db.Uuid
  position            Int
  title               String     @db.VarChar(255)
  type                LessonType @default(VIDEO)
  videoAssetId        String?    @map("video_asset_id") @db.Uuid
  durationSeconds     Int?       @map("duration_seconds")
  /// Share of the video (0–1) that must actually be covered to count as complete.
  completionThreshold Decimal    @default(0.90) @map("completion_threshold") @db.Decimal(3, 2)
  isFreePreview       Boolean    @default(false) @map("is_free_preview")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  module           CourseModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  videoAsset       VideoAsset?       @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  quiz             Quiz?
  progress         LessonProgress[]
  playbackSessions PlaybackSession[]
  comments         LessonComment[]

  @@unique([moduleId, position])
  @@index([videoAssetId])
  @@map("lessons")
}

/// A video stored on the secure host (VdoCipher / Bunny Stream). Status is driven
/// by the host's encoding webhooks. We never store a playable URL — only the id.
model VideoAsset {
  id              String           @id @default(uuid(7)) @db.Uuid
  provider        VideoProvider
  providerVideoId String           @map("provider_video_id") @db.VarChar(128)
  status          VideoAssetStatus @default(PENDING_UPLOAD)
  durationSeconds Int?             @map("duration_seconds")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  lessons Lesson[]

  @@unique([provider, providerVideoId])
  @@map("video_assets")
}

// -----------------------------------------------------------------------------
//  Enrollment (access rights)
// -----------------------------------------------------------------------------

model Enrollment {
  id                  String              @id @default(uuid(7)) @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  courseId            String              @map("course_id") @db.Uuid
  status              EnrollmentStatus
  source              EnrollmentSource
  /// Anchor for time-based drip ("X days since registration"). Set once, on creation.
  accessStartsAt      DateTime            @map("access_starts_at") @db.Timestamptz(3)
  /// NULL = lifetime access.
  expiresAt           DateTime?           @map("expires_at") @db.Timestamptz(3)
  statusReason        AccessChangeReason? @map("status_reason")
  statusChangedAt     DateTime            @map("status_changed_at") @db.Timestamptz(3)
  externalOrderId     String?             @map("external_order_id") @db.VarChar(191)
  /// Event time of the newest access change applied (webhook occurred_at, or
  /// now() for admin overrides). Webhooks are not delivered in order: anything
  /// older than this is ignored instead of overwriting newer state.
  lastAccessEventAt   DateTime?           @map("last_access_event_at") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course                    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  history EnrollmentStatusHistory[]

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([status, expiresAt])
  @@map("enrollments")
}

/// Append-only trail of every access change, for support and dispute evidence.
model EnrollmentStatusHistory {
  id             BigInt             @id @default(autoincrement())
  enrollmentId   String             @map("enrollment_id") @db.Uuid
  fromStatus     EnrollmentStatus?  @map("from_status")
  toStatus       EnrollmentStatus   @map("to_status")
  fromExpiresAt  DateTime?          @map("from_expires_at") @db.Timestamptz(3)
  toExpiresAt    DateTime?          @map("to_expires_at") @db.Timestamptz(3)
  reason         AccessChangeReason
  source         EnrollmentSource
  actorUserId    String?            @map("actor_user_id") @db.Uuid
  webhookEventId String?            @map("webhook_event_id") @db.Uuid
  note           String?            @db.VarChar(500)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  webhookEvent WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  @@index([enrollmentId, createdAt])
  @@map("enrollment_status_history")
}

// -----------------------------------------------------------------------------
//  Playback, analytics & progress
// -----------------------------------------------------------------------------

/// Created each time the backend issues playback credentials (OTP / signed URL).
/// Progress pings must reference a live playback session, and `watermarkCode`
/// is burned into the dynamic watermark so a leaked recording traces back here.
model PlaybackSession {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  lessonId        String    @map("lesson_id") @db.Uuid
  userSessionId   String    @map("user_session_id") @db.Uuid
  watermarkCode   String    @unique @map("watermark_code") @db.VarChar(16)
  ipAddress       String    @map("ip_address") @db.Inet
  userAgent       String?   @map("user_agent") @db.VarChar(512)
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamptz(3)
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userSession UserSession @relation(fields: [userSessionId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([lessonId, startedAt])
  @@map("playback_sessions")
}

/// Raw, append-only progress pings (every 5–10 s per viewer).
/// High-volume: range-partitioned by month on received_at (see the init
/// migration) and intentionally free of foreign keys. Rows are rolled up into
/// lesson_progress in near-real-time and dropped by partition after retention.
model PlaybackHeartbeat {
  id                BigInt    @default(autoincrement())
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  playbackSessionId String    @map("playback_session_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  lessonId          String    @map("lesson_id") @db.Uuid
  positionSeconds   Float     @map("position_seconds") @db.Real
  /// Watch time credited for this interval after server-side clamping
  /// (≤ wall-clock gap × max playback rate) — never trusted from the client.
  creditedSeconds   Int       @map("credited_seconds") @db.SmallInt
  playbackRate      Float     @default(1) @map("playback_rate") @db.Real
  clientCompleted   Boolean   @default(false) @map("client_completed")
  clientSentAt      DateTime? @map("client_sent_at") @db.Timestamptz(3)

  @@id([id, receivedAt])
  @@index([playbackSessionId, receivedAt])
  @@index([userId, receivedAt])
  @@map("playback_heartbeats")
}

/// One row per (student, lesson): the hot "state" record the player resumes from.
model LessonProgress {
  userId              String    @map("user_id") @db.Uuid
  lessonId            String    @map("lesson_id") @db.Uuid
  /// Resume point.
  lastPositionSeconds Int       @default(0) @map("last_position_seconds")
  /// Furthest point reached through continuous viewing (seeking does not move it).
  maxPositionSeconds  Int       @default(0) @map("max_position_seconds")
  /// Total server-credited watch time (re-watching counts).
  watchedSeconds      Int       @default(0) @map("watched_seconds")
  /// Bitset of 5-second buckets actually watched. Completion = covered share
  /// >= lesson.completion_threshold, so scrubbing to the end does not complete.
  coverageBitmap      Bytes?    @map("coverage_bitmap")
  completed           Boolean   @default(false)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(3)
  firstWatchedAt      DateTime  @default(now()) @map("first_watched_at") @db.Timestamptz(3)
  lastWatchedAt       DateTime  @default(now()) @map("last_watched_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([lessonId, completed])
  @@map("lesson_progress")
}

/// Materialised module completion so the drip check is a single PK lookup.
model ModuleProgress {
  userId           String    @map("user_id") @db.Uuid
  moduleId         String    @map("module_id") @db.Uuid
  completedLessons Int       @default(0) @map("completed_lessons")
  totalLessons     Int       @map("total_lessons")
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@map("module_progress")
}

// -----------------------------------------------------------------------------
//  Quizzes (randomised pool, strict pass gate)
// -----------------------------------------------------------------------------

/// A quiz is a lesson of type QUIZ. The lesson only counts as completed when an
/// attempt scores >= passing_score_percent, and every later lesson in the course
/// stays locked until then (time-based drip never bypasses a failed quiz).
model Quiz {
  id                   String   @id @default(uuid(7)) @db.Uuid
  lessonId             String   @unique @map("lesson_id") @db.Uuid
  passingScorePercent  Int      @default(70) @map("passing_score_percent") @db.SmallInt
  /// How many questions are drawn at random from the active pool per attempt.
  questionsPerAttempt  Int      @map("questions_per_attempt") @db.SmallInt
  shuffleOptions       Boolean  @default(true) @map("shuffle_options")
  timeLimitSeconds     Int?     @map("time_limit_seconds")
  /// NULL = unlimited attempts.
  maxAttempts          Int?     @map("max_attempts") @db.SmallInt
  retryCooldownMinutes Int      @default(0) @map("retry_cooldown_minutes")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id          String           @id @default(uuid(7)) @db.Uuid
  quizId      String           @map("quiz_id") @db.Uuid
  type        QuizQuestionType
  prompt      String
  explanation String?
  points      Int              @default(1) @db.SmallInt
  /// Retire a question without breaking historical attempts that reference it.
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  quiz         Quiz                  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options      QuizOption[]
  attemptItems QuizAttemptQuestion[]

  @@index([quizId, isActive])
  @@map("quiz_questions")
}

model QuizOption {
  id         String  @id @default(uuid(7)) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  label      String
  /// Never serialised to students; grading happens server-side only.
  isCorrect  Boolean @map("is_correct")
  position   Int     @db.SmallInt

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@map("quiz_options")
}

model QuizAttempt {
  id            String            @id @default(uuid(7)) @db.Uuid
  quizId        String            @map("quiz_id") @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  attemptNumber Int               @map("attempt_number") @db.SmallInt
  status        QuizAttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt     DateTime?         @map("expires_at") @db.Timestamptz(3)
  submittedAt   DateTime?         @map("submitted_at") @db.Timestamptz(3)
  scorePercent  Decimal?          @map("score_percent") @db.Decimal(5, 2)
  passed        Boolean?

  quiz      Quiz                  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuizAttemptQuestion[]

  @@unique([quizId, userId, attemptNumber])
  @@index([userId, quizId, passed])
  @@map("quiz_attempts")
}

/// The questions drawn for one attempt, in the order and option order served.
model QuizAttemptQuestion {
  attemptId         String   @map("attempt_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  position          Int      @db.SmallInt
  /// Option ids in the shuffled order the student saw.
  optionOrder       String[] @map("option_order") @db.Uuid
  selectedOptionIds String[] @default([]) @map("selected_option_ids") @db.Uuid
  isCorrect         Boolean? @map("is_correct")
  pointsAwarded     Int?     @map("points_awarded") @db.SmallInt

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([attemptId, questionId])
  @@unique([attemptId, position])
  @@map("quiz_attempt_questions")
}

// -----------------------------------------------------------------------------
//  Lesson Q&A (threaded)
// -----------------------------------------------------------------------------

/// depth 0 = question, 1 = answer, 2 = reply to an answer (max depth enforced in
/// the service). `rootId` lets a whole thread load with one indexed query.
model LessonComment {
  id               String        @id @default(uuid(7)) @db.Uuid
  lessonId         String        @map("lesson_id") @db.Uuid
  authorId         String        @map("author_id") @db.Uuid
  parentId         String?       @map("parent_id") @db.Uuid
  rootId           String?       @map("root_id") @db.Uuid
  depth            Int           @default(0) @db.SmallInt
  body             String
  status           CommentStatus @default(VISIBLE)
  isPinned         Boolean       @default(false) @map("is_pinned")
  /// Root questions only.
  isResolved       Boolean       @default(false) @map("is_resolved")
  /// Answers only: marked by the asker or an instructor.
  isAcceptedAnswer Boolean       @default(false) @map("is_accepted_answer")
  /// Denormalised on the root for list views.
  replyCount       Int           @default(0) @map("reply_count")
  editedAt         DateTime?     @map("edited_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson   Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   LessonComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  LessonComment[] @relation("CommentReplies")
  root     LessonComment?  @relation("CommentThread", fields: [rootId], references: [id], onDelete: Cascade)
  inThread LessonComment[] @relation("CommentThread")

  @@index([lessonId, parentId, createdAt(sort: Desc)])
  @@index([rootId, createdAt])
  @@index([authorId])
  @@map("lesson_comments")
}

// -----------------------------------------------------------------------------
//  Integration & audit infrastructure
// -----------------------------------------------------------------------------

/// Idempotency + replay ledger for inbound webhooks. (provider, event_id) is
/// processed at most once; a re-delivery returns the stored result.
model WebhookEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  provider      String             @db.VarChar(64)
  eventId       String             @map("event_id") @db.VarChar(191)
  /// Which signing key authenticated the request (supports key rotation audits).
  keyId         String             @map("key_id") @db.VarChar(64)
  /// SHA-256 of the raw body: the same event_id with a different body is rejected.
  payloadSha256 String             @map("payload_sha256") @db.Char(64)
  status        WebhookEventStatus
  attempts      Int                @default(1)
  occurredAt    DateTime           @map("occurred_at") @db.Timestamptz(3)
  result        Json?
  lastError     String?            @map("last_error")
  receivedAt    DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt   DateTime?          @map("processed_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollmentChanges EnrollmentStatusHistory[]

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

/// Transactional outbox: side effects (emails, cache busts) are written in the same
/// transaction as the state change and delivered by a worker afterwards.
model OutboxMessage {
  id          String       @id @default(uuid(7)) @db.Uuid
  type        String       @db.VarChar(64)
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_messages")
}

/// Administrative tracking: who did what to which entity.
model AuditLog {
  id         BigInt         @id @default(autoincrement())
  actorType  AuditActorType @map("actor_type")
  /// User UUID for USER, signing key id for WEBHOOK.
  actorId    String?        @map("actor_id") @db.VarChar(191)
  action     String         @db.VarChar(64)
  entityType String         @map("entity_type") @db.VarChar(64)
  entityId   String         @map("entity_id") @db.VarChar(191)
  metadata   Json?
  ipAddress  String?        @map("ip_address") @db.Inet
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@map("audit_logs")
}
